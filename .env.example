# =====================================================================
#  JARVIS – Umgebungskonfiguration
#  Kopiere diese Datei nach ".env" und trage deine Werte ein.
#  Die Datei ".env" wird NIEMALS committet (siehe .gitignore) und
#  NIEMALS an den Browser ausgeliefert. JARVIS läuft komplett lokal –
#  es werden keine API-Keys benötigt.
# =====================================================================

# --- Ollama (lokales Sprachmodell) -----------------------------------
# Ollama installieren: https://ollama.com/download   (läuft als Dienst)
OLLAMA_HOST=http://127.0.0.1:11434
# Modell mit Tool-Calling-Unterstützung. Installieren mit:  ollama pull qwen3:8b
#   qwen3:8b      -> empfohlen (gutes Deutsch, zuverlässige Tools, ~5 GB)
#   qwen3:4b      -> für schwächere Rechner
#   qwen3:14b     -> klüger, braucht ~10 GB RAM/VRAM
#   mistral-nemo  -> gutes Deutsch
OLLAMA_MODEL=qwen3:8b

# --- Spracherkennung (faster-whisper, lokal) ---------------------------
# tiny | base | small | medium | large-v3-turbo | large-v3
#   small          -> guter Kompromiss auf der CPU
#   large-v3-turbo -> beste Qualität, empfohlen mit NVIDIA-GPU
STT_MODEL=small
# auto | cpu | cuda
STT_DEVICE=auto

# --- Stimme (Piper TTS, lokal) -----------------------------------------
# Stimmen liegen in data/voices/ – herunterladen mit:
#   python scripts/download_models.py
# Deutsche Hauptstimme (männlich):  de_DE-thorsten-high
VOICE_NAME=de_DE-thorsten-high
# Stimme für englische Antworten:  en_GB-alan-medium
VOICE_NAME_EN=en_GB-alan-medium
# Primäre Sprache (JARVIS antwortet automatisch in der Sprache des Benutzers)
VOICE_LANGUAGE=de-DE
# slow | calm | normal | fast
VOICE_SPEED=calm
# Beschreibung der Sprechweise (beeinflusst die Formulierungen)
VOICE_STYLE=tief, ruhig, warm, souverän und professionell – wie ein erfahrener persönlicher Assistent

# --- Server ---------------------------------------------------------
# Nur lokal binden! Nicht auf 0.0.0.0 ändern, außer du weißt genau was du tust.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
LOG_LEVEL=INFO

# --- Computerzugriff ------------------------------------------------
# READ_ONLY | LIMITED | FULL_ACCESS  (Startwert, änderbar in den Settings)
ACCESS_LEVEL=LIMITED
# Ordner, auf die Datei-Tools zugreifen dürfen (mit ; getrennt).
# Leer = dein Benutzerordner.
ALLOWED_PATHS=

# --- E-Mail (optional, IMAP/SMTP) -----------------------------------
# Das Passwort wird NICHT hier gespeichert, sondern im sicheren
# Schlüsselbund des Betriebssystems:  python scripts/set_email_password.py
EMAIL_ADDRESS=
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587

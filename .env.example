# =====================================================================
#  JARVIS – Umgebungskonfiguration
#  Kopiere diese Datei nach ".env" und trage deine Werte ein.
#  Die Datei ".env" wird NIEMALS committet (siehe .gitignore) und
#  NIEMALS an den Browser ausgeliefert.
# =====================================================================

# --- Google Gemini --------------------------------------------------
# API-Key erstellen: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Live-/Voice-Modell (Gemini Live API, native Audio)
#   gemini-3.8-live                      -> Standard, niedrige Latenz
#   gemini-3.8-live-extended-thinking    -> mehr Hintergrund-Reasoning
GEMINI_LIVE_MODEL=gemini-3.8-live

# --- Stimme ---------------------------------------------------------
# Prebuilt-Voice der Gemini Live API. Tiefe, ruhige männliche Stimmen:
#   Charon (informativ, tief), Orus (fest), Iapetus (klar),
#   Algenib (rau, tief), Schedar (gleichmäßig), Umbriel (gelassen)
VOICE_NAME=Charon
# Primäre Sprache (JARVIS antwortet automatisch in der Sprache des Benutzers)
VOICE_LANGUAGE=de-DE
# slow | calm | normal | fast
VOICE_SPEED=calm
# Freitext-Stilbeschreibung, wird in die Systemanweisung übernommen
VOICE_STYLE=tief, ruhig, warm, souverän und professionell – wie ein erfahrener persönlicher Assistent

# --- Server ---------------------------------------------------------
# Nur lokal binden! Nicht auf 0.0.0.0 ändern, außer du weißt genau was du tust.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
LOG_LEVEL=INFO

# --- Computerzugriff ------------------------------------------------
# READ_ONLY | LIMITED | FULL_ACCESS  (Startwert, änderbar in den Settings)
ACCESS_LEVEL=LIMITED
# Ordner, auf die Datei-Tools zugreifen dürfen (mit ; getrennt).
# Leer = dein Benutzerordner.
ALLOWED_PATHS=

# --- E-Mail (optional, IMAP/SMTP) -----------------------------------
# Das Passwort wird NICHT hier gespeichert, sondern im sicheren
# Schlüsselbund des Betriebssystems:  python scripts/set_email_password.py
EMAIL_ADDRESS=
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
